( main.tal )
( devices )
|10 @Console &vector $2 &read $1 &pad $5 &write $1 &error $1

~print_h.tal

~machine_h.tal

( init )
|0100
    ;initStack JSR2

    ;Stack PrintShort
    PrintSpace LIT "- EMIT LIT "> EMIT PrintSpace
    ;Stack/data PrintShort
    ( ;Stack/pointer LDA2 PrintShort )
    NewLine
    NewLine

    #0002 Int ;push_obj JSR2    ( int2 )
    Id ;push_obj JSR2             ( id int1 )
    #0001 Int ;push_obj JSR2    ( int1 id int2 )
    FnAdd ;push_obj JSR2          ( FnAdd int2 )
    Apply ;push_obj JSR2          ( apply )
    DUP2 PrintShort NewLine NewLine

    ;Stack/data OVR2 #0010 ADD2
    ;DumpMem JSR2
    NewLine

    ;step JSR2
    ;printObjMem JSR2
    DUP2 PrintShort NewLine NewLine

BRK

@printObjMem
    NewLine
    DUP2 PrintShort NewLine NewLine
    DUP2 #0010 ADD2
    ;Stack SWP2
    ;DumpMem JSR2
    JMP2r

